# This file is installed as /etc/lumen-terminal/runtime.env.
# A network interface name (lo, eth0) or an address (127.0.0.1, 0.0.0.0)
# is accepted by libwebsockets.
LUMEN_INTERFACE=lo
LUMEN_PORT=7681
LUMEN_SECURITY_CONFIG=/etc/lumen-terminal/security.conf
LUMEN_MAX_CLIENTS=16
LUMEN_PING_INTERVAL=15
LUMEN_MAX_SESSIONS=16
LUMEN_PTY_HISTORY_BYTES=2097152
LUMEN_ROOT_MAX_SESSIONS=2
LUMEN_ROOT_IDLE_SESSION_SECONDS=1800
